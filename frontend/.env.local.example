# =============================================================================
# LOCAL DEVELOPMENT — copy to frontend/.env.local
# =============================================================================

NEXT_PUBLIC_API_URL=http://localhost:5000

# Optional override for Socket.IO. Local: defaults to NEXT_PUBLIC_API_URL.
# AWS Lightsail production: omit both and the browser uses the page origin
# (nginx/Cloudflare must proxy /socket.io to Node). Or set explicitly:
# NEXT_PUBLIC_SOCKET_URL=https://api.your-domain.com

# Admin→customer WebRTC audio calls (1:1). Set false to hide/disable UI.
# NEXT_PUBLIC_AUDIO_CALLS_ENABLED=true

# Must match backend GUEST_CUSTOMER_EMAIL (admin guest-order display + contact-email checks)
# NEXT_PUBLIC_GUEST_CUSTOMER_EMAIL=customer@motd.test

# Must match backend GOOGLE_CLIENT_ID
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Public mailto + Contact Us display address. Match backend CONTACT_INBOX.
# NEXT_PUBLIC_CONTACT_EMAIL=uaemotd@gmail.com

# Optional: used by next.config.mjs to proxy /uploads in dev
# API_PROXY_TARGET=http://localhost:5000

# Staff activity log is /en/admin/activity and requires a full admin session.

# =============================================================================
# PRODUCTION (AWS Lightsail)
# Prefer same origin via Cloudflare/nginx → Node (omit NEXT_PUBLIC_API_URL).
# Never bake localhost into the frontend build.
# If API is on another host: NEXT_PUBLIC_API_URL + NEXT_PUBLIC_SOCKET_URL=https://api…
#   NEXT_PUBLIC_GOOGLE_CLIENT_ID=<same as backend GOOGLE_CLIENT_ID>
# =============================================================================
