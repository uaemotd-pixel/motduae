# =============================================================================
# LOCAL DEVELOPMENT — copy to backend/.env
# Uses your local MongoDB instance (mongodb://127.0.0.1:27017/motd)
# =============================================================================

# Required
MONGODB_URI=mongodb://127.0.0.1:27017/motd
JWT_SECRET=change-me-to-a-long-random-string
# Access token lifetime (jsonwebtoken expiresIn). Keep short; role/isActive are revalidated from DB on each request.
JWT_EXPIRES_IN=1d

# Server
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# Google Sign-In (customers only)
# Authorized JavaScript origins: http://localhost:3000
GOOGLE_CLIENT_ID=

# Transactional email (AWS SES). Use EMAIL_PROVIDER=console for local/CI without AWS.
EMAIL_PROVIDER=console
AWS_REGION=eu-west-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
SES_FROM_EMAIL=noreply@yourdomain.com
SES_FROM_NAME=MOTD
SES_REPLY_TO=support@yourdomain.com
CONTACT_INBOX=uaemotd@gmail.com
# SES_CONFIGURATION_SET=

# Stripe (test keys from https://dashboard.stripe.com/test/apikeys)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Shipa Delivery (defaults to stub — no network calls until SHIPA_MODE=live + keys)
SHIPA_MODE=stub
SHIPA_API_KEY=
SHIPA_BASE_URL=
SHIPA_WEBHOOK_SECRET=

# =============================================================================
# PRODUCTION (Vercel) — set in Vercel project → Settings → Environment Variables
# Same project hosts frontend + API; NEXT_PUBLIC_API_URL is not required.
#   MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/motd?retryWrites=true&w=majority
#   CORS_ORIGIN=https://your-app.vercel.app
#   FRONTEND_URL=https://your-app.vercel.app
#   NODE_ENV=production
#   JWT_SECRET=<long random string>
#   JWT_EXPIRES_IN=1d
#   GOOGLE_CLIENT_ID=...
#   NEXT_PUBLIC_GOOGLE_CLIENT_ID=... (same as GOOGLE_CLIENT_ID)
#   EMAIL_PROVIDER=ses
#   AWS_REGION=...
#   AWS_ACCESS_KEY_ID=...
#   AWS_SECRET_ACCESS_KEY=...
#   SES_FROM_EMAIL=noreply@yourdomain.com
#   SES_FROM_NAME=MOTD
#   SES_REPLY_TO=support@yourdomain.com
#   CONTACT_INBOX=uaemotd@gmail.com
# =============================================================================
